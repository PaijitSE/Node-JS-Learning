<!doctype html>
<html>

<head></head>

<body>

    <section id="features" class="ud-features">
        <div class="container">
            <h1>Products</h1>
            <% products.map((product)=>{ %>
                <h4>
                    <a href="/products/<%=product.id%>">
                        <%=product.productTitle %>
                    </a>
                </h4>
                <p>
                    <%=product.productDescription %>
                </p>
                <p>
                    <%=product.productPrice %>
                </p>
                <%}) %>

        </div>
    </section>

</body>

</html>